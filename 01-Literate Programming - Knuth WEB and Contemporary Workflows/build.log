,{"t":"Space"},{"t":"Str","c":"form"},{"t":"Space"},{"t":"Str","c":"of"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"remaster:"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"explanation"},{"t":"Space"},{"t":"Str","c":"remains"},{"t":"Space"},{"t":"Str","c":"adjacent"},{"t":"Space"},{"t":"Str","c":"to"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"corresponding"},{"t":"Space"},{"t":"Str","c":"chunks"},{"t":"Space"},{"t":"Str","c":"rather"},{"t":"Space"},{"t":"Str","c":"than"},{"t":"Space"},{"t":"Str","c":"being"},{"t":"Space"},{"t":"Str","c":"extracted"},{"t":"Space"},{"t":"Str","c":"into"},{"t":"Space"},{"t":"Str","c":"separate,"},{"t":"Space"},{"t":"Str","c":"repetitive"},{"t":"Space"},{"t":"Str","c":"sections."}]},{"t":"Para","c":[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Str","c":"top"},{"t":"Space"},{"t":"Str","c":"level"},{"t":"Space"},{"t":"Str","c":"defines"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"program’s"},{"t":"Space"},{"t":"Str","c":"intent"},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Str","c":"order"},{"t":"Space"},{"t":"Str","c":"of"},{"t":"Space"},{"t":"Str","c":"composition:"}]},{"t":"CodeBlock","c":[["",["text"],[]],"# Printing primes: a C++ reboot\n\nThis program prints the first 1000 prime numbers.\nThe top-level structure is deliberately simple:\ngenerate the prime table, then print it.\n\n<<program>>=\n#include <cstddef>\n#include <iomanip>\n#include <iostream>\n#include <vector>\n\n<<constants>>\n<<types>>\n<<declarations>>\n\nint main() {\n    const auto primes = generate_primes(PRIME_COUNT);\n    print_table(primes);\n    return 0;\n}\n\n<<prime-generation>>\n<<table-output>>\n@"]},{"t":"Para","c":[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Str","c":"output"},{"t":"Space"},{"t":"Str","c":"parameters"},{"t":"Space"},{"t":"Str","c":"define"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"table"},{"t":"Space"},{"t":"Str","c":"layout"},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Str","c":"preserve"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"connection"},{"t":"Space"},{"t":"Str","c":"with"},{"t":"Space"},{"t":"Str","c":"Donald"},{"t":"Space"},{"t":"Str","c":"Knuth’s"},{"t":"Space"},{"t":"Str","c":"original"},{"t":"Space"},{"t":"Str","c":"example:"}]},{"t":"CodeBlock","c":[["",["text"],[]],"The output format follows Knuth's original example:\n50 rows per page, 4 columns, 10 character positions per column.\n\n<<constants>>=\nconstexpr std::size_t PRIME_COUNT = 1000;\nconstexpr std::size_t ROWS_PER_PAGE = 50;\nconstexpr std::size_t COLUMNS_PER_PAGE = 4;\nconstexpr int COLUMN_WIDTH = 10;\n@"]},{"t":"Para","c":[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Str","c":"container"},{"t":"Space"},{"t":"Str","c":"for"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"table"},{"t":"Space"},{"t":"Str","c":"of"},{"t":"Space"},{"t":"Str","c":"prime"},{"t":"Space"},{"t":"Str","c":"numbers"},{"t":"Space"},{"t":"Str","c":"is"},{"t":"Space"},{"t":"Str","c":"assigned"},{"t":"Space"},{"t":"Str","c":"a"},{"t":"Space"},{"t":"Str","c":"distinct"},{"t":"Space"},{"t":"Str","c":"semantic"},{"t":"Space"},{"t":"Str","c":"role:"}]},{"t":"CodeBlock","c":[["",["text"],[]],"The table of primes is represented as a growing sequence.\nThe alias makes the role of the container explicit.\n\n<<types>>=\nusing PrimeTable = std::vector<int>;\n@"]},{"t":"Para","c":[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Str","c":"function"},{"t":"Space"},{"t":"Str","c":"declarations"},{"t":"Space"},{"t":"Str","c":"establish"},{"t":"Space"},{"t":"Str","c":"a"},{"t":"Space"},{"t":"Str","c":"separation"},{"t":"Space"},{"t":"Str","c":"of"},{"t":"Space"},{"t":"Str","c":"responsibilities"},{"t":"Space"},{"t":"Str","c":"between"},{"t":"Space"},{"t":"Str","c":"generation,"},{"t":"Space"},{"t":"Str","c":"candidate"},{"t":"Space"},{"t":"Str","c":"validation,"},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Str","c":"output:"}]},{"t":"CodeBlock","c":[["",["text"],[]],"Generation, candidate checking, and output are introduced\nas separate operations.\n\n<<declarations>>=\nPrimeTable generate_primes(std::size_t count);\nbool is_prime_candidate(int candidate, const PrimeTable& primes);\nvoid print_table(const PrimeTable& primes);\n@"]},{"t":"Para","c":[{"t":"Str","c":"Prime-number"},{"t":"Space"},{"t":"Str","c":"generation"},{"t":"Space"},{"t":"Str","c":"preserves"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"algorithm"},{"t":"Space"},{"t":"Str","c":"of"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"remaster"},{"t":"Space"},{"t":"Str","c":"version"},{"t":"Space"},{"t":"Str","c":"without"},{"t":"Space"},{"t":"Str","c":"altering"},{"t":"Space"},{"t":"Str","c":"its"},{"t":"Space"},{"t":"Str","c":"logic:"}]},{"t":"CodeBlock","c":[["",["text"],[]],"<<prime-generation>>=\nPrimeTable generate_primes(std::size_t count) {\n    PrimeTable primes;\n    if (count == 0) return primes;\n    primes.push_back(2);\n\n    for (int candidate = 3; primes.size() < count; candidate += 2) {\n        if (is_prime_candidate(candidate, primes)) {\n            primes.push_back(candidate);\n        }\n    }\n    return primes;\n}\n\nbool is_prime_candidate(int candidate, const PrimeTable& primes) {\n    for (int p : primes) {\n        if (p > candidate / p) return true;\n        if (candidate % p == 0) return false;\n    }\n    return true;\n}\n@"]},{"t":"Para","c":[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Str","c":"output"},{"t":"Space"},{"t":"Str","c":"phase"},{"t":"Space"},{"t":"Str","c":"preserves"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"page-by-page"},{"t":"Space"},{"t":"Str","c":"layout"},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"calculation"},{"t":"Space"},{"t":"Str","c":"of"},{"t":"Space"},{"t":"Str","c":"indices"},{"t":"Space"},{"t":"Str","c":"by"},{"t":"Space"},{"t":"Str","c":"row"},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Str","c":"column:"}]},{"t":"CodeBlock","c":[["",["text"],[]],"<<table-output>>=\nvoid print_table(const PrimeTable& primes) {\n    std::size_t page_number = 1;\n    std::size_t page_offset = 0;\n\n    while (page_offset < primes.size()) {\n        std::cout << \"The First \" << primes.size()\n                  << \" Prime Numbers --- Page \" << page_number << \"\\n\\n\";\n\n        for (std::size_t row = 0; row < ROWS_PER_PAGE; ++row) {\n            for (std::size_t column = 0; column < COLUMNS_PER_PAGE; ++column) {\n                const std::size_t index = page_offset + row + column * ROWS_PER_PAGE;\n                if (index < primes.size()) {\n                    std::cout << std::setw(COLUMN_WIDTH) << primes[index];\n                }\n            }\n            std::cout << '\\n';\n        }\n\n        std::cout << '\\n';\n        ++page_number;\n        page_offset += ROWS_PER_PAGE * COLUMNS_PER_PAGE;\n    }\n}\n@"]},{"t":"Para","c":[{"t":"Code","c":[["",[],[]],"primes.nw"]},{"t":"Space"},{"t":"Str","c":"remains"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"canonical"},{"t":"Space"},{"t":"Str","c":"literate"},{"t":"Space"},{"t":"Str","c":"source;"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"primes.cpp"]},{"t":"Space"},{"t":"Str","c":"serves"},{"t":"Space"},{"t":"Str","c":"as"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"generated"},{"t":"Space"},{"t":"Str","c":"machine"},{"t":"Space"},{"t":"Str","c":"artifact;"},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"output.txt"]},{"t":"Space"},{"t":"Str","c":"serves"},{"t":"Space"},{"t":"Str","c":"as"},{"t":"Space"},{"t":"Str","c":"the"},{"t":"Space"},{"t":"Str","c":"smoke-check"},{"t":"Space"},{"t":"Str","c":"output."}]},{"t":"Header","c":[2,["g.-additional-bells-and-whistles",[],[]],[{"t":"Str","c":"G."},{"t":"Space"},{"t":"Str","c":"Additional"},{"t":